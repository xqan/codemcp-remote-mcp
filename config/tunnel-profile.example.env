# Copy this file to config/tunnel-profile.local.env. The local copy is ignored.
# Do not commit runtime API keys or private organization identifiers.

CONTROL_PLANE_TUNNEL_ID=tunnel_replace_with_platform_id
# Set CONTROL_PLANE_API_KEY in the process environment or a Windows secret store.
# CONTROL_PLANE_API_KEY=sk-replace-me

TUNNEL_CLIENT_PROFILE=codemcp-bridge
TUNNEL_CLIENT_PROFILE_DIR=.local/tunnel-client
BRIDGE_MCP_URL=http://127.0.0.1:46200/mcp
HEALTH_LISTEN_ADDR=127.0.0.1:46201
TUNNEL_HEALTH_URL=http://127.0.0.1:46201

# Optional: the OpenAI-Organization header for the tunnel control plane.
# CONTROL_PLANE_ORGANIZATION_ID=org_replace_with_platform_org_id
